---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import { site, LANGS, pagePath, SITE_URL, mapsLink, type Lang, type PageKey } from '../data/site';
import { ui, nav } from '../i18n/ui';

interface Props { lang: Lang; page: PageKey; title: string; description: string; noindex?: boolean; }
const { lang, page, title, description, noindex = false } = Astro.props;

const htmlLang = { mr: 'mr-IN', en: 'en-IN', hi: 'hi-IN' }[lang];
const canonical = new URL(pagePath(lang, page), SITE_URL).href;
const fullTitle = page === 'home' ? title : `${title} | ${site.name[lang]}`;

const bizDescription: Record<Lang, string> = {
  mr: 'लातूरमधील शुद्ध शाकाहारी केटरिंग सेवा: लग्न, समारंभ, पार्टी व पूजेसाठी महाराष्ट्रीयन, दाक्षिणात्य, राजस्थानी, गुजराती, बंगाली व इंडो-चायनीज जेवण. ३०+ वर्षांचा अनुभव. FSSAI प्रमाणित.',
  en: 'Pure vegetarian catering in Latur for weddings, events, parties and pujas: Maharashtrian, South Indian, Rajasthani and more food. 30+ years of experience. FSSAI Certified.',
  hi: 'लातूर में शुद्ध शाकाहारी कैटरिंग: शादी, समारोह, पार्टी और पूजा के लिए महाराष्ट्रीयन, दक्षिण भारतीय, राजस्थानी, गुजराती, बंगाली और इंडो-चायनीज भोजन। 30+ साल का अनुभव। FSSAI प्रमाणित।',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': ['FoodEstablishment', 'LocalBusiness'],
  '@id': `${SITE_URL}/#business`,
  name: site.name.en,
  alternateName: [site.name.mr, site.name.hi],
  description: bizDescription[lang],
  url: SITE_URL,
  inLanguage: lang,
  image: new URL('/art/og-card.png', SITE_URL).href,
  telephone: `+${site.phoneIntl}`,
  email: site.email,
  address: { '@type': 'PostalAddress', streetAddress: site.address.street.en, addressLocality: 'Latur', addressRegion: 'Maharashtra', postalCode: site.address.postalCode, addressCountry: 'IN' },
  hasMap: mapsLink(),
  servesCuisine: ['Maharashtrian', 'South Indian', 'Rajasthani', 'Gujarati', 'Bengali', 'Indo-Chinese', 'Vegetarian'],
  areaServed: site.areas.map((a) => ({ '@type': 'City', name: a.en })),
  sameAs: Object.values(site.social).filter(Boolean),
};

// BreadcrumbList for every page except home: Home > This page.
const uiPages = { credits: ui.credits, terms: ui.terms, privacy: ui.privacy, cookies: ui.cookies } as Record<string, Record<Lang, string>>;
const pageName = page === 'home' ? ui.home[lang] : uiPages[page] ? uiPages[page][lang] : (nav as Record<string, Record<Lang, string>>)[page][lang];
const breadcrumb = page === 'home' ? null : {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.home[lang], item: new URL(pagePath(lang, 'home'), SITE_URL).href },
    { '@type': 'ListItem', position: 2, name: pageName, item: canonical },
  ],
};
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#7a1f2b" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pagePath(l, page), SITE_URL).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath('mr', page), SITE_URL).href} />
    <link rel="icon" type="image/svg+xml" href="/art/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />
    <meta property="og:image" content={new URL('/art/og-card.png', SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />}
  </head>
  <body>
    <a class="skip" href="#main">{ui.skip[lang]}</a>
    <Header lang={lang} page={page} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <ActionBar lang={lang} />
  </body>
</html>
