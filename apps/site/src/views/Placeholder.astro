---
import Base from '../layouts/Base.astro';
import { nav, ui } from '../i18n/ui';
import { pagePath, type Lang, type PageKey } from '../data/site';
interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const label = page === 'credits' ? ui.credits[lang] : (nav as any)[page]?.[lang] ?? page;
const soon = { mr: 'हे पृष्ठ लवकरच येत आहे.', en: 'This page is coming soon.', hi: 'यह पृष्ठ जल्द आ रहा है।' }[lang];
---
<Base lang={lang} page={page} title={label} description={soon} noindex>
  <section class="section center">
    <div class="wrap">
      <h1>{label}</h1>
      <p class="lead">{soon}</p>
      <div class="btn-row"><a class="btn btn-primary" href={pagePath(lang, 'home')}>{ui.home[lang]}</a></div>
    </div>
  </section>
</Base>
