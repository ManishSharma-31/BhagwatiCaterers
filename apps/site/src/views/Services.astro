---
import Base from '../layouts/Base.astro';
import { services } from '../content/services';
import { site, waLink, pagePath, type Lang, type PageKey } from '../data/site';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; page: PageKey; }
const { lang } = Astro.props;
const c = services[lang];
import Photo from '../components/Photo.astro';
import { slots } from '../content/gallery';
const altOf = (n: string) => slots.find((s) => s.name === n)!.alt[lang];
const icOf = (n: string) => slots.find((s) => s.name === n)!.icon;
// service index -> photo (0 wedding, 3 housewarming, 4 puja, 5 parties)
const svcPhoto: Record<number, string> = { 0: 'hero-wedding-decor', 3: 'kalash', 4: 'puja-thali', 5: 'buffet-counter' };
---
<Base lang={lang} page="services" title={c.metaTitle} description={c.metaDescription}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>{c.h1}</h1>
        <p class="lead">{c.lead}</p>
        <p class="note">{c.note}</p>
      </div>
      <figure class="hero-photo">
        <picture>
          <source type="image/webp" srcset="/photos/kalash-decorated-800.webp 800w" sizes="(min-width: 900px) 40vw, 100vw" />
          <img src="/photos/kalash-decorated-800.jpg" alt={altOf('kalash-decorated')} width="800" height="600" fetchpriority="high" decoding="async" />
        </picture>
      </figure>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="grid three">
        {c.items.map((s, i) => (
          <article class="card">
            {svcPhoto[i] ? (
              <div class="ph"><Photo name={svcPhoto[i]} alt={altOf(svcPhoto[i])} width={800} height={600} representative lang={lang} fallbackIcon={icOf(svcPhoto[i])} /></div>
            ) : (
              <img class="icon" src={s.icon} alt="" width="64" height="64" loading="lazy" />
            )}
            <h2 class="h3">{s.title}</h2>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section alt center">
    <div class="wrap">
      <h2>{c.closeTitle}</h2>
      <p class="lead">{c.closeBody}</p>
      <div class="btn-row"><a class="btn btn-ghost" href={pagePath(lang, 'packages')}>{{ mr: 'ऑर्डर कशी द्यावी', en: 'How to order', hi: 'ऑर्डर कैसे करें' }[lang]}</a></div>
    </div>
  </section>
  <section class="section alt center">
    <div class="wrap">
      <img class="art-divider" src="/art/divider-kolam.svg" alt="" width="400" height="40" loading="lazy" />
      <h2>{c.ctaTitle}</h2>
      <p class="lead">{c.ctaBody}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={pagePath(lang, 'quote')}>{ui.getQuote[lang]}</a>
        <a class="btn btn-wa" href={waLink(lang)} target="_blank" rel="noopener">💬 {ui.whatsapp[lang]}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .h3 { font-size: 1.3rem; }
  .hero-photo { margin: 0; }
  .hero-photo img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 14px; box-shadow: var(--shadow); display: block; }
  .rep { font-size: .8rem; color: #6b5a50; margin: .35rem 0 0; text-align: center; }
  .ph { margin: -.4rem -.4rem .8rem; }
  .ph :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; display: block; }
  .ph :global(.rep) { font-size: .75rem; color: #6b5a50; margin: .25rem 0 0; }
</style>
