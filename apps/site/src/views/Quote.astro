---
import Base from '../layouts/Base.astro';
import { quote, qdesign, events, orderTypes, cuisineOpts, otherTown, messageLabels } from '../content/quote';
import { ui } from '../i18n/ui';
import { site, waLink, pagePath, type Lang, type PageKey } from '../data/site';
interface Props { lang: Lang; page: PageKey; }
const { lang } = Astro.props;
const c = quote[lang];
const d = qdesign[lang];
---
<Base lang={lang} page="quote" title={c.metaTitle} description={c.metaDescription}>
  <section class="section quote-page">
    <div class="wrap">
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
      <div class="q-layout">
      <aside class="q-panel">
        <img class="q-logo" src="/art/logo.svg" alt="" width="72" height="72" />
        <h2>{d.panelTitle}</h2>
        <p>{d.panelBody}</p>
        <ol class="q-steps">{d.steps.map((x) => <li>{x}</li>)}</ol>
        <ul class="q-trust">{d.trust.map((x) => <li>{x}</li>)}</ul>
        <div class="q-contact">
          <a class="btn btn-primary" href={`tel:+${site.phoneIntl}`}>📞 {d.callNow}: {site.phone}</a>
          <a class="btn btn-wa" href={waLink(lang)} target="_blank" rel="noopener">💬 WhatsApp</a>
        </div>
        <img class="q-art" src="/art/rangoli-corner.svg" alt="" width="160" height="160" loading="lazy" />
      </aside>
      <div class="q-main">

      <noscript>
        <p class="card"><strong>{c.noscript}</strong></p>
        <div class="btn-row" style="margin-bottom:1.5rem">
          <a class="btn btn-primary" href={`tel:+${site.phoneIntl}`}>{site.phone}</a>
          <a class="btn btn-wa" href={waLink(lang)} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </noscript>

      <form id="quote-form" class="form q-form" novalidate data-labels={JSON.stringify(messageLabels[lang])} data-phone={site.phoneIntl}>
        <div class="hp" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <h2 class="q-h"><span>1</span>{d.s1}</h2>
        <div>
          <label for="name">{c.name} *</label>
          <input id="name" name="name" type="text" autocomplete="name" required aria-describedby="err-name" />
          <p class="err" id="err-name" aria-live="polite"></p>
        </div>
        <div>
          <label for="phone">{c.phone} *</label>
          <input id="phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel" required aria-describedby="err-phone" />
          <p class="err" id="err-phone" aria-live="polite"></p>
        </div>
        <h2 class="q-h"><span>2</span>{d.s2}</h2>
        <div>
          <label for="event">{c.event} *</label>
          <select id="event" name="event" required aria-describedby="err-event">
            <option value="">{c.choose}</option>
            {events.map((e) => <option value={e.key}>{e[lang]}</option>)}
          </select>
          <p class="err" id="err-event" aria-live="polite"></p>
        </div>
        <div class="pair">
        <div>
          <label for="date">{c.date} {c.optional}</label>
          <input id="date" name="date" type="date" />
        </div>
        <div>
          <label for="guests">{c.guests} *</label>
          <input id="guests" name="guests" type="number" min="1" inputmode="numeric" required aria-describedby="err-guests" />
          <p class="err" id="err-guests" aria-live="polite"></p>
        </div>
        </div>
        <div class="pair">
        <div>
          <label for="town">{c.town}</label>
          <select id="town" name="town">
            <option value="">{c.choose}</option>
            {site.areas.map((a) => <option value={a.key}>{a[lang]}</option>)}
            <option value="other">{otherTown[lang]}</option>
          </select>
        </div>
        <div>
          <label for="order">{c.order}</label>
          <select id="order" name="order">
            <option value="">{c.choose}</option>
            {orderTypes.map((o) => <option value={o.key}>{o[lang]}</option>)}
          </select>
        </div>
        </div>
        <h2 class="q-h"><span>3</span>{d.s3}</h2>
        <fieldset class="opts">
          <legend>{c.cuisine}</legend>
          {cuisineOpts.map((o) => (
            <label class="opt"><input type="checkbox" name="cuisine" value={o.key} /> {o[lang]}</label>
          ))}
        </fieldset>
        <div id="quote-dishes" class="qd" data-remove={d.dishesRemove}>
          <p class="qd-t">🛒 {d.dishesTitle}</p>
          <ul id="quote-dishes-list" class="qd-list"></ul>
          <p id="quote-dishes-none" class="qd-none">{d.dishesNone}</p>
          <div class="qd-actions"><a class="btn btn-ghost" href={pagePath(lang, 'menu')}>{d.dishesAdd}</a><button type="button" id="quote-dishes-clear" class="qd-clear" hidden>{d.dishesClear}</button></div>
        </div>
        <div>
          <label for="notes">{c.notes}</label>
          <textarea id="notes" name="notes" rows="4"></textarea>
        </div>
        <button class="btn btn-wa q-submit" type="submit">💬 {c.submit}</button>
        <p class="note">{c.privacy} <a href={pagePath(lang, 'privacy')}>{ui.privacy[lang]}</a> · <a href={pagePath(lang, 'terms')}>{ui.terms[lang]}</a></p>
      </form>

      <section id="quote-done" class="card done" hidden aria-live="polite">
        <h2>{c.doneTitle}</h2>
        <p>{c.doneBody}</p>
        <pre id="quote-msg" class="msg"></pre>
        <div class="btn-row">
          <button type="button" id="quote-copy" class="btn btn-ghost" data-ok={c.copied} data-manual={c.manual}>{c.copy}</button>
          <a class="btn btn-primary" href={`tel:+${site.phoneIntl}`}>{c.callBtn}: {site.phone}</a>
          <a class="btn btn-wa" href={waLink(lang)} target="_blank" rel="noopener">{c.waBtn}</a>
        </div>
        <p class="note" id="quote-copied" role="status"></p>
      </section>
      </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .qd { background: #fffaf0; border: 2px dashed #d9c9a8; border-radius: 14px; padding: .9rem 1rem; }
  .qd-t { margin: 0 0 .4rem; font-weight: 700; color: var(--maroon); }
  .qd-list { list-style: none; margin: 0 0 .5rem; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .qd-list :global(li) { display: inline-flex; align-items: center; gap: .3rem; background: #fff; border: 1.5px solid var(--maroon); border-radius: 999px; padding: .15rem .3rem .15rem .8rem; }
  :global(.qd-rm) { border: 0; background: none; color: #a11a1a; font: inherit; font-weight: 700; cursor: pointer; padding: .35rem .5rem; min-height: 36px; }
  .qd-none { margin: 0 0 .6rem; font-size: .95rem; color: #5a4036; }
  .qd-actions { display: flex; gap: .6rem; align-items: center; flex-wrap: wrap; }
  .qd-clear { border: 0; background: none; color: #a11a1a; font: inherit; font-weight: 700; cursor: pointer; min-height: 44px; }
  .quote-page { background: linear-gradient(180deg, #fff6e3 0%, #fdeccb 100%); }
  .q-layout { display: grid; gap: 1.5rem; margin-top: 1.25rem; align-items: start; }
  @media (min-width: 900px) { .q-layout { grid-template-columns: 340px 1fr; } .q-panel { position: sticky; top: 5.5rem; } }
  .q-panel { background: linear-gradient(160deg, #7a1f2b 0%, #5c1620 100%); color: #fff6e3; border-radius: 20px; padding: 1.5rem; box-shadow: var(--shadow); position: relative; overflow: hidden; }
  .q-panel h2 { color: #f2b01e; margin: .5rem 0 .4rem; font-size: 1.5rem; }
  .q-panel p { margin: 0 0 1rem; opacity: .95; }
  .q-logo { display: block; }
  .q-steps { list-style: none; counter-reset: s; margin: 0 0 1rem; padding: 0; display: grid; gap: .5rem; }
  .q-steps li { counter-increment: s; display: flex; align-items: center; gap: .7rem; font-weight: 600; }
  .q-steps li::before { content: counter(s); flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: #f2b01e; color: #5c1620; display: grid; place-items: center; font-weight: 800; }
  .q-trust { list-style: none; margin: 0 0 1.1rem; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .q-trust li { background: rgba(255,246,227,.14); border: 1px solid rgba(242,176,30,.5); border-radius: 999px; padding: .25rem .7rem; font-size: .88rem; }
  .q-contact { display: grid; gap: .6rem; position: relative; z-index: 1; }
  .q-art { position: absolute; right: -40px; bottom: -40px; width: 150px; opacity: .22; pointer-events: none; }
  .q-main { background: #fff; border-radius: 20px; padding: 1.5rem 1.25rem; box-shadow: var(--shadow); border-top: 6px solid #f2b01e; }
  .q-form { max-width: none; gap: 1.1rem; }
  .q-h { display: flex; align-items: center; gap: .6rem; font-size: 1.25rem; color: var(--maroon); margin: .6rem 0 0; padding-bottom: .4rem; border-bottom: 2px dashed #ecd9a8; }
  .q-h:first-of-type { margin-top: 0; }
  .q-h span { width: 2rem; height: 2rem; border-radius: 50%; background: var(--maroon); color: #fff; display: grid; place-items: center; font-size: 1rem; }
  .pair { display: grid; gap: 1rem; }
  @media (min-width: 560px) { .pair { grid-template-columns: 1fr 1fr; } }
  .q-form input:focus, .q-form select:focus, .q-form textarea:focus { outline: 3px solid #f2b01e; border-color: var(--maroon); }
  .q-submit { width: 100%; font-size: 1.15rem; min-height: 56px; box-shadow: 0 6px 16px rgba(30,120,60,.3); }
  .opts { display: flex; flex-wrap: wrap; gap: .6rem; border: 0; padding: 0; background: none; }
  .opts legend { width: 100%; padding: 0; margin-bottom: .5rem; font-weight: 700; }
  .opt { position: relative; margin: 0; padding: .55rem 1rem !important; border: 2px solid #d9c9a8; border-radius: 999px; background: #fffaf0; cursor: pointer; min-height: 48px; }
  .opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .opt:has(input:checked) { background: var(--maroon); border-color: var(--maroon); color: #fff; font-weight: 700 !important; }
  .opt:has(input:focus-visible) { outline: 3px solid #f2b01e; }
  .done { margin-top: 0; max-width: none; }
  .err { color: #a11a1a; font-weight: 700; margin: .25rem 0 0; min-height: 0; font-size: .98rem; }
  .err:empty { display: none; }
  .form [aria-invalid='true'] { border-color: #a11a1a; }
  .done { margin-top: 2rem; max-width: 640px; }
  .done[hidden] { display: none; }
  .msg { white-space: pre-wrap; background: var(--cream-2); border-radius: 10px; padding: 1rem; font: inherit; margin: 0 0 1rem; }
</style>
<script>
  import { initQuoteForm } from '../scripts/quote';
  initQuoteForm();
</script>
