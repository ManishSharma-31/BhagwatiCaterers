---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { gallery, slots } from '../content/gallery';
import { waLink, pagePath, type Lang, type PageKey } from '../data/site';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; page: PageKey; }
const { lang } = Astro.props;
const c = gallery[lang];
---
<Base lang={lang} page="gallery" title={c.metaTitle} description={c.metaDescription}>
  <section class="section">
    <div class="wrap">
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
      <p class="note">{c.note}</p>
      <div class="grid three gal">
        {slots.map((s) => (
          <Photo name={s.name} alt={s.alt[lang]} representative fallbackIcon={s.icon} lang={lang} />
        ))}
      </div>
    </div>
  </section>
  <section class="section alt center">
    <div class="wrap">
      <h2>{c.ctaTitle}</h2>
      <p class="lead">{c.ctaBody}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={pagePath(lang, 'quote')}>{ui.getQuote[lang]}</a>
        <a class="btn btn-wa" href={waLink(lang)} target="_blank" rel="noopener">{ui.whatsapp[lang]}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .gal { margin-top: 1.5rem; grid-template-columns: repeat(2, 1fr); gap: .75rem; }
  @media (min-width: 700px) { .gal { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; } }
  .gal :global(.photo img) { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; height: auto; }
</style>
