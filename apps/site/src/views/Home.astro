---
import Base from '../layouts/Base.astro';
import { home } from '../content/home';
import { site, waLink, pagePath, type Lang, type PageKey } from '../data/site';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; page: PageKey; }
const { lang } = Astro.props;
const c = home[lang];
import Photo from '../components/Photo.astro';
import { slots } from '../content/gallery';
const altOf = (n: string) => slots.find((s) => s.name === n)!.alt[lang];
const icOf = (n: string) => slots.find((s) => s.name === n)!.icon;
const cuisinePhotos: Array<string | null> = ['misal-pav', 'idli-sambar', 'dal-baati-churma'];
---
<Base lang={lang} page="home" title={c.metaTitle} description={c.metaDescription}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <ul class="badges">
          <li>🌿 {ui.pureVeg[lang]}</li>
          <li>{ui.yearsExp[lang]}</li>
          <li>{ui.fssaiCertified[lang]}</li>
        </ul>
        <h1>{c.heroTitle}</h1>
        <p class="lead">{c.heroLead}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={pagePath(lang, 'quote')}>{ui.getQuote[lang]}</a>
          <a class="btn btn-wa" href={waLink(lang)} target="_blank" rel="noopener">💬 {ui.whatsapp[lang]}</a>
          <a class="btn btn-ghost" href={`tel:+${site.phoneIntl}`}>📞 {site.phone}</a>
        </div>
      </div>
      <figure class="hero-photo">
        <picture>
          <source type="image/webp" srcset="/photos/hero-wedding-decor-800.webp 800w, /photos/hero-wedding-decor-1600.webp 1600w" sizes="(min-width: 900px) 40vw, 100vw" />
          <img src="/photos/hero-wedding-decor-800.jpg" alt={altOf('hero-wedding-decor')} width="800" height="1000" fetchpriority="high" decoding="async" />
        </picture>
        <figcaption class="rep">{ui.repImage[lang]}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="center">{c.orderTitle}</h2>
      <p class="lead center">{c.orderLead}</p>
      <div class="grid three">
        {c.orders.map((o, i) => (
          <article class={`card ${i < 2 ? 'big' : ''}`}>
            <img class="icon" src={o.icon} alt="" width="64" height="64" loading="lazy" />
            <h3>{o.title}</h3>
            <p>{o.body}</p>
            <ul>{o.points.map((p) => <li>{p}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="btn-row center" style="margin-top:1.5rem">
        <a class="btn btn-primary" href={pagePath(lang, 'packages')}>{{ mr: 'ऑर्डर कशी द्यायची ते पाहा', en: 'See how to order', hi: 'ऑर्डर का तरीका देखें' }[lang]}</a>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2 class="center">{c.cuisineTitle}</h2>
      <p class="note center">{c.cuisineNote}</p>
      <div class="grid three">
        {c.cuisines.map((x, i) => (
          <article class="card">
            {cuisinePhotos[i] ? (
              <div class="ph"><Photo name={cuisinePhotos[i]!} alt={altOf(cuisinePhotos[i]!)} width={800} height={600} representative lang={lang} fallbackIcon={icOf(cuisinePhotos[i]!)} /></div>
            ) : (
              <img class="icon" src={x.icon} alt="" width="64" height="64" loading="lazy" />
            )}
            <h3>{x.title}</h3>
            <p>{x.dishes}</p>
          </article>
        ))}
      </div>
      <div class="btn-row center" style="margin-top:1.5rem">
        <a class="btn btn-ghost" href={pagePath(lang, 'menu')}>{{ mr: 'पूर्ण मेनू पाहा', en: 'See the full menu', hi: 'पूरा मेन्यू देखें' }[lang]}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap center">
      <div class="ph band"><Photo name="marigold-entrance" alt={altOf('marigold-entrance')} width={800} height={400} representative lang={lang} fallbackIcon={icOf('marigold-entrance')} /></div>
      <h2>{c.occasionTitle}</h2>
      <ul class="chips" style="justify-content:center">
        {c.occasions.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <h2 class="center">{c.whyTitle}</h2>
      <div class="grid three">
        {c.why.map((w) => (
          <article class="card"><h3>{w.title}</h3><p>{w.body}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap center">
      <h2>{c.areasTitle}</h2>
      <p>{c.areasNote}</p>
      <ul class="chips" style="justify-content:center">
        {site.areas.map((a) => <li>{a[lang]}</li>)}
      </ul>
    </div>
  </section>

  <section class="section alt center">
    <div class="wrap">
      <h2>{c.ctaTitle}</h2>
      <p class="lead">{c.ctaBody}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={pagePath(lang, 'quote')}>{ui.getQuote[lang]}</a>
        <a class="btn btn-wa" href={waLink(lang)} target="_blank" rel="noopener">💬 {ui.whatsapp[lang]}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero-photo { margin: 0; }
  .hero-photo img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: center 40%; border-radius: var(--radius, 14px); box-shadow: var(--shadow); display: block; }
  @media (min-width: 900px) { .hero-photo img { aspect-ratio: 4 / 5; } }
  .rep, .hero-photo :global(.rep) { font-size: .8rem; color: #6b5a50; margin: .35rem 0 0; text-align: center; }
  .ph { margin: -.4rem -.4rem .8rem; }
  .ph :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; display: block; }
  .ph :global(.rep) { font-size: .75rem; color: #6b5a50; margin: .25rem 0 0; }
  .band { margin: 0 auto 1.5rem; max-width: 900px; }
  .band :global(img) { aspect-ratio: 16 / 7; object-position: center 35%; }
</style>
