---
import { site, LANGS, pagePath, type Lang, type PageKey } from '../data/site';
import { nav, ui } from '../i18n/ui';
interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const items = ['services', 'menu', 'packages', 'gallery', 'about', 'areas', 'contact'] as const;
---
<header class="site-header">
  <div class="wrap head-inner">
    <a class="brand" href={pagePath(lang, 'home')}>
      <img src="/art/logo.svg" alt="" width="44" height="44" />
      <span class="brand-name">{site.name[lang]}</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>☰ {lang === 'en' ? 'Menu' : 'मेनू'}</button>
    <nav id="site-nav" class="nav" aria-label="Main">
      {items.map((k) => (
        <a href={pagePath(lang, k)} aria-current={page === k ? 'page' : undefined}>{nav[k][lang]}</a>
      ))}
      <div class="lang" role="group" aria-label={ui.language[lang]}>
        {LANGS.map((l) => (
          <a href={pagePath(l, page)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{ui.langNames[l]}</a>
        ))}
      </div>
    </nav>
  </div>
  <div class="toran" style="background-image:url(/art/border-paithani.svg)" aria-hidden="true"></div>
</header>
<script>
  const btn = document.querySelector('[data-nav-toggle]');
  const navEl = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
